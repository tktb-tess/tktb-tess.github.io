---
import { BASE_URL, SITE_NAME } from '../modules/consts';

interface Props {
  readonly title: string;
  readonly path: string;
  readonly description?: string;
}

const { title, description = title, path } = Astro.props;
const pageURL = new URL(path, BASE_URL).href;
const linkCardURL = new URL('/link_card.png', BASE_URL).href;
---

<meta name='description' content={description} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:type' content='website' />
<meta property='og:url' content={pageURL} />
<meta property='og:site_name' content={SITE_NAME} />
<meta property='og:image' content={linkCardURL} />
<meta name='twitter:card' content='summary' />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={linkCardURL} />
